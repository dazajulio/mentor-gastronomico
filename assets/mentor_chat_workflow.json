<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mentor Gastronómico AI</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        .chat-container { height: 400px; overflow-y: auto;
}
        .message { margin-bottom: 12px; padding: 10px; border-radius: 8px; max-width: 80%; font-family: sans-serif;
}
        .user-msg { background-color: #e2e8f0; align-self: flex-end; margin-left: auto; color: #1a202c;
}
        .bot-msg { background-color: #3b82f6; color: white; align-self: flex-start;
}
    </style>
</head>
<body class="bg-gray-100 flex items-center justify-center min-h-screen">

    <div class="bg-white p-6 rounded-xl shadow-2xl w-full max-w-lg">
        <div class="flex items-center space-x-4 mb-4 border-b pb-4">
            <div class="bg-blue-600 text-white p-3 rounded-full">👨‍🍳</div>
            <div>
                <h1 class="text-xl font-bold text-gray-800">Mentor Gastronómico</h1>
                <p class="text-sm text-green-500 font-medium">Conectado a n8n</p>
            </div>
        </div>

        <div id="chatBox" class="chat-container flex flex-col space-y-2 mb-4 p-2 border rounded bg-gray-50">
            <div class="message bot-msg">¡Hola! Soy el asistente de Julio Daza. ¿Me podrías decir tu nombre y correo para agendar tu auditoría?</div>
        </div>

        <div class="flex space-x-2">
            <input type="text" id="userInput" placeholder="Escribe aquí..." 
                   class="flex-1 border p-2 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-400">
            <button onclick="enviarMensaje()" id="sendBtn" 
                    class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 transition">
                Enviar
            </button>
        </div>
    </div>

    <script>
        // CONFIGURACIÓN CORREGIDA
        const N8N_WEBHOOK_URL = 'https: //bot.dazajulio.com/webhook/webhook/chat'; // Sin espacios
        const SECURITY_TOKEN = 'secure-token-placeholder'; // Asegúrate que coincida con n8n
        const SESSION_ID = 'session_' + Math.random().toString(36).substr(2,
9);

        const chatBox = document.getElementById('chatBox');
        const userInput = document.getElementById('userInput');
        const sendBtn = document.getElementById('sendBtn');

        function appendMessage(text, isUser) {
            const msgDiv = document.createElement('div');
            msgDiv.className = `message ${isUser ? 'user-msg' : 'bot-msg'
    }`;
            msgDiv.innerText = text;
            chatBox.appendChild(msgDiv);
            chatBox.scrollTop = chatBox.scrollHeight;
}

        async function enviarMensaje() {
            const text = userInput.value.trim();
            if (!text) return;

            appendMessage(text, true);
            userInput.value = '';
            userInput.disabled = true;
            sendBtn.disabled = true;

            try {
                const response = await fetch(N8N_WEBHOOK_URL,
        {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'x-mentor-token': SECURITY_TOKEN
            },
                    body: JSON.stringify({
                        body: { // Envolvemos en 'body' para que coincida con tu nodo de n8n
                            sessionId: SESSION_ID,
                            message: text
                }
            })
        });

                if (response.status === 401) {
                    throw new Error('Token de seguridad inválido (401)');
        }

                if (!response.ok) {
                    throw new Error(`Error del servidor: ${response.status
            }`);
        }

                const data = await response.json();
                appendMessage(data.output || "Procesado correctamente.", false);
    } catch (error) {
                appendMessage("❌ Error: " + error.message, false);
                console.error("Detalle del error:", error);
    } finally {
                userInput.disabled = false;
                sendBtn.disabled = false;
                userInput.focus();
    }
}

        userInput.addEventListener("keypress", (e) => {
            if (e.key === "Enter") enviarMensaje();
});
    </script>
</body>
</html>